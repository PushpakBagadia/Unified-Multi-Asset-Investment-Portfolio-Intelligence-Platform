@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

:root {
  --bg-primary: #060913;
  --bg-secondary: #0b1120;
  --bg-glass: rgba(17, 24, 39, 0.6);
  --bg-glass-card: rgba(255, 255, 255, 0.03);
  --border-glass: rgba(255, 255, 255, 0.07);
  --border-glass-focus: rgba(255, 255, 255, 0.15);
  --text-primary: #f3f4f6;
  --text-secondary: #9ca3af;
  --text-muted: #6b7280;
  
  --color-equity: #3b82f6;      /* Blue */
  --color-mf: #10b981;          /* Green */
  --color-gold: #f59e0b;        /* Gold/Amber */
  --color-fd: #8b5cf6;          /* Purple */
  --color-nps: #06b6d4;         /* Cyan */
  --color-crypto: #ec4899;      /* Pink */
  
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-info: #3b82f6;

  --sidebar-width: 260px;
  --topbar-height: 70px;
  --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --shadow-glow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
  --border-radius-lg: 16px;
  --border-radius-md: 12px;
  --border-radius-sm: 8px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
  background-image: 
    radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.08) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(236, 72, 153, 0.05) 0px, transparent 50%),
    radial-gradient(at 50% 50%, rgba(16, 185, 129, 0.05) 0px, transparent 50%);
  background-attachment: fixed;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
  background: var(--border-glass);
  border-radius: var(--border-radius-sm);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--border-glass-focus);
}

/* Main Layout Grid */
.app-container {
  display: flex;
  min-height: 100vh;
}

/* Sidebar Styling */
.sidebar {
  width: var(--sidebar-width);
  background: var(--bg-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-right: 1px solid var(--border-glass);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  padding: 24px 16px;
}

.brand-section {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 32px;
  padding: 0 8px;
}

.logo-container {
  width: 40px;
  height: 40px;
  border-radius: var(--border-radius-md);
  background: linear-gradient(135deg, var(--color-equity), var(--color-mf));
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
}

.brand-info h1 {
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.5px;
  background: linear-gradient(to right, #ffffff, #d1d5db);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.brand-info span {
  font-size: 0.7rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.nav-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}

.nav-item a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--border-radius-md);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: all 0.2s ease;
  position: relative;
}

.nav-item a:hover {
  background: var(--bg-glass-card);
  color: var(--text-primary);
}

.nav-item.active a {
  background: rgba(59, 130, 246, 0.15);
  color: #fff;
  border-left: 3px solid var(--color-equity);
}

.nav-badge {
  margin-left: auto;
  font-size: 0.75rem;
  padding: 2px 8px;
  border-radius: 999px;
  font-weight: bold;
}

.nav-badge.ai-badge {
  background: linear-gradient(to right, #ec4899, #8b5cf6);
  color: white;
  box-shadow: 0 0 10px rgba(236, 72, 253, 0.4);
}

.nav-badge.count-badge {
  background: var(--color-danger);
  color: white;
}

.user-card {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid var(--border-glass);
  display: flex;
  align-items: center;
  gap: 12px;
}

.user-avatar {
  width: 42px;
  height: 42px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--color-fd), var(--color-crypto));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: white;
  font-size: 0.95rem;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.kyc-status {
  font-size: 0.72rem;
  display: flex;
  align-items: center;
  gap: 4px;
  color: var(--color-success);
}

.kyc-status i {
  font-size: 0.7rem;
}

.settings-dots {
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
  transition: all 0.2s;
}

.settings-dots:hover {
  color: var(--text-primary);
  background: var(--bg-glass-card);
}

/* Page Wrapper */
.main-wrapper {
  margin-left: var(--sidebar-width);
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Top Bar Styling */
.topbar {
  height: var(--topbar-height);
  background: var(--bg-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-glass);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  position: sticky;
  top: 0;
  z-index: 99;
}

.page-title h2 {
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: -0.5px;
}

.search-container {
  width: 400px;
  position: relative;
}

.search-container i {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  font-size: 1rem;
}

.search-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-glass);
  border-radius: var(--border-radius-lg);
  padding: 10px 16px 10px 42px;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 0.88rem;
  transition: all 0.3s;
}

.search-input:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--border-glass-focus);
  box-shadow: 0 0 15px rgba(59, 130, 246, 0.1);
}

/* Search Dropdown / Autocomplete Results */
.search-results-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  width: 100%;
  background: var(--bg-secondary);
  border: 1px solid var(--border-glass);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-glow);
  z-index: 101;
  display: none;
  max-height: 300px;
  overflow-y: auto;
  padding: 8px;
}

.search-results-dropdown.active {
  display: block;
}

.search-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border-radius: var(--border-radius-md);
  cursor: pointer;
  transition: background 0.2s;
}

.search-result-item:hover {
  background: var(--bg-glass-card);
}

.search-result-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-result-avatar {
  width: 32px;
  height: 32px;
  border-radius: var(--border-radius-sm);
  background: var(--bg-glass-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.75rem;
}

.search-result-text {
  display: flex;
  flex-direction: column;
}

.search-result-name {
  font-size: 0.85rem;
  font-weight: 600;
}

.search-result-type {
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.topbar-btn {
  width: 40px;
  height: 40px;
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-glass);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  cursor: pointer;
  position: relative;
  transition: all 0.2s;
}

.topbar-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--border-glass-focus);
}

.topbar-btn .unread-dot {
  width: 8px;
  height: 8px;
  background: var(--color-danger);
  border-radius: 999px;
  position: absolute;
  top: 8px;
  right: 8px;
}

/* Page Containers styling */
.content-area {
  padding: 32px;
  flex: 1;
}

.page {
  display: none;
  animation: fadeIn 0.3s ease-in-out;
}

.page.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

/* View Transitions Setup */
::view-transition-group(*),
::view-transition-old(*),
::view-transition-new(*) {
  animation-duration: 0.25s;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

/* Glassmorphism Generic Elements */
.glass-card {
  background: var(--bg-glass-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-glass);
  border-radius: var(--border-radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-glow);
  position: relative;
  transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
}

.glass-card:hover {
  border-color: var(--border-glass-focus);
  transform: translateY(-2px);
}

/* Buttons */
.btn {
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 600;
  padding: 10px 18px;
  border-radius: var(--border-radius-md);
  border: 1px solid transparent;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-equity), #1d4ed8);
  color: white;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(59, 130, 246, 0.35);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--border-glass);
  color: var(--text-primary);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--border-glass-focus);
}

.btn-outline-danger {
  background: transparent;
  border-color: rgba(239, 68, 68, 0.4);
  color: var(--color-danger);
}

.btn-outline-danger:hover {
  background: rgba(239, 68, 68, 0.1);
}

/* Badges */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-radius: var(--border-radius-sm);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge-success {
  background: rgba(16, 185, 129, 0.12);
  color: var(--color-success);
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.badge-danger {
  background: rgba(239, 68, 68, 0.12);
  color: var(--color-danger);
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.badge-warning {
  background: rgba(245, 158, 11, 0.12);
  color: var(--color-warning);
  border: 1px solid rgba(245, 158, 11, 0.2);
}

.badge-info {
  background: rgba(59, 130, 246, 0.12);
  color: var(--color-info);
  border: 1px solid rgba(59, 130, 246, 0.2);
}

/* Grids and Layout systems */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 24px;
}

.col-span-2 {
  grid-column: span 2;
}

.col-span-3 {
  grid-column: span 3;
}

.col-span-4 {
  grid-column: span 4;
}

/* Welcome Segment */
.welcome-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.welcome-info h3 {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.welcome-sub {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 4px;
}

.welcome-actions {
  display: flex;
  gap: 12px;
}

/* Dismissible Nudges */
.nudge-card {
  background: rgba(245, 158, 11, 0.05);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-left: 4px solid var(--color-warning);
  border-radius: var(--border-radius-md);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  transition: all 0.3s;
}

.nudge-card.nudge-success {
  background: rgba(16, 185, 129, 0.05);
  border-color: rgba(16, 185, 129, 0.2);
  border-left-color: var(--color-success);
}

.nudge-card.nudge-info {
  background: rgba(59, 130, 246, 0.05);
  border-color: rgba(59, 130, 246, 0.2);
  border-left-color: var(--color-info);
}

.nudge-content {
  display: flex;
  align-items: center;
  gap: 14px;
}

.nudge-icon {
  font-size: 1.25rem;
  color: var(--color-warning);
}

.nudge-success .nudge-icon {
  color: var(--color-success);
}

.nudge-info .nudge-icon {
  color: var(--color-info);
}

.nudge-text {
  font-size: 0.88rem;
  color: var(--text-primary);
  line-height: 1.4;
}

.nudge-close {
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  border-radius: 99px;
  transition: all 0.2s;
  display: flex;
  align-items: center;
}

.nudge-close:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

/* Stat Card specific elements */
.stat-card {
  padding: 20px;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.stat-label {
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-secondary);
}

.stat-icon {
  color: var(--text-muted);
  width: 20px;
  height: 20px;
}

.stat-value {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-bottom: 8px;
}

.stat-sub {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.stat-sparkline {
  height: 40px;
  margin-top: 14px;
  width: 100%;
}

.stat-sparkline svg {
  width: 100%;
  height: 100%;
}

/* Asset Allocation styling */
.allocation-bar {
  height: 16px;
  border-radius: 99px;
  display: flex;
  overflow: hidden;
  margin: 16px 0 24px 0;
  background: rgba(255, 255, 255, 0.05);
}

.allocation-seg {
  height: 100%;
  transition: width 0.4s ease;
  position: relative;
}

.allocation-seg:hover::after {
  content: attr(data-percentage) '%';
  position: absolute;
  top: -24px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--bg-secondary);
  border: 1px solid var(--border-glass);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.65rem;
  color: white;
  pointer-events: none;
}

.allocation-seg.eq { background: var(--color-equity); }
.allocation-seg.mf { background: var(--color-mf); }
.allocation-seg.gold { background: var(--color-gold); }
.allocation-seg.fd { background: var(--color-fd); }
.allocation-seg.nps { background: var(--color-nps); }
.allocation-seg.crypto { background: var(--color-crypto); }

.allocation-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.allocation-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  border-radius: var(--border-radius-md);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
}

.allocation-item-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  font-weight: 500;
}

.allocation-dot {
  width: 8px;
  height: 8px;
  border-radius: 99px;
}

.allocation-dot.eq { background: var(--color-equity); }
.allocation-dot.mf { background: var(--color-mf); }
.allocation-dot.gold { background: var(--color-gold); }
.allocation-dot.fd { background: var(--color-fd); }
.allocation-dot.nps { background: var(--color-nps); }
.allocation-dot.crypto { background: var(--color-crypto); }

.allocation-val {
  font-size: 0.85rem;
  font-weight: 700;
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.card-title {
  font-size: 1rem;
  font-weight: 700;
}

.card-link {
  font-size: 0.8rem;
  color: var(--color-equity);
  text-decoration: none;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.card-link:hover {
  text-decoration: underline;
}

/* Top Holdings styling */
.holdings-list, .transactions-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.holding-row, .transaction-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-radius: var(--border-radius-md);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  transition: all 0.2s;
}

.holding-row:hover, .transaction-row:hover {
  background: rgba(255, 255, 255, 0.04);
}

.holding-info, .transaction-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.holding-avatar, .transaction-avatar {
  width: 36px;
  height: 36px;
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: white;
  font-size: 0.8rem;
}

.holding-avatar.eq { background: rgba(59, 130, 246, 0.2); color: var(--color-equity); border: 1px solid rgba(59, 130, 246, 0.3); }
.holding-avatar.mf { background: rgba(16, 185, 129, 0.2); color: var(--color-mf); border: 1px solid rgba(16, 185, 129, 0.3); }
.holding-avatar.gold { background: rgba(245, 158, 11, 0.2); color: var(--color-gold); border: 1px solid rgba(245, 158, 11, 0.3); }
.holding-avatar.fd { background: rgba(139, 92, 246, 0.2); color: var(--color-fd); border: 1px solid rgba(139, 92, 246, 0.3); }
.holding-avatar.nps { background: rgba(6, 182, 212, 0.2); color: var(--color-nps); border: 1px solid rgba(6, 182, 212, 0.3); }
.holding-avatar.crypto { background: rgba(236, 72, 153, 0.2); color: var(--color-crypto); border: 1px solid rgba(236, 72, 153, 0.3); }

.holding-details, .transaction-details {
  display: flex;
  flex-direction: column;
}

.holding-name, .transaction-name {
  font-size: 0.85rem;
  font-weight: 600;
}

.holding-sub, .transaction-sub {
  font-size: 0.72rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.holding-right, .transaction-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.holding-value, .transaction-val-text {
  text-align: right;
}

.holding-val-num, .transaction-val-num {
  font-size: 0.88rem;
  font-weight: 700;
}

/* Portfolio Page elements */
.filter-tabs-container {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 8px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--border-glass);
}

.filter-tab {
  padding: 8px 16px;
  border-radius: var(--border-radius-lg);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-secondary);
  background: transparent;
  border: 1px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}

.filter-tab:hover {
  color: var(--text-primary);
  background: var(--bg-glass-card);
}

.filter-tab.active {
  background: rgba(59, 130, 246, 0.12);
  color: #fff;
  border-color: rgba(59, 130, 246, 0.3);
}

.timeframe-selector {
  display: flex;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-glass);
  padding: 4px;
  border-radius: var(--border-radius-md);
}

.tf-btn {
  background: transparent;
  border: none;
  font-family: var(--font-main);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 6px 12px;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: all 0.2s;
}

.tf-btn.active {
  background: var(--border-glass-focus);
  color: white;
}

.portfolio-chart-wrapper {
  margin-top: 18px;
  height: 300px;
  position: relative;
}

/* Invest Tab & Fund Cards */
.fund-card {
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 280px;
}

.fund-header {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.fund-logo {
  width: 44px;
  height: 44px;
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: 800;
  font-size: 0.9rem;
}

.fund-identity {
  display: flex;
  flex-direction: column;
}

.fund-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.fund-category {
  font-size: 0.72rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.fund-grid-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 20px;
  padding: 12px;
  background: rgba(0, 0, 0, 0.15);
  border-radius: var(--border-radius-md);
}

.fund-stat-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.fund-stat-label {
  font-size: 0.65rem;
  color: var(--text-secondary);
  text-transform: uppercase;
}

.fund-stat-val {
  font-size: 0.82rem;
  font-weight: 700;
}

.fund-stat-val.up {
  color: var(--color-success);
}

.chips-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}

.chip-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-glass);
  border-radius: 99px;
  padding: 6px 14px;
  font-family: var(--font-main);
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s;
}

.chip-btn:hover {
  background: var(--bg-glass-card);
  color: var(--text-primary);
}

.chip-btn.active {
  background: var(--color-equity);
  color: white;
  border-color: var(--color-equity);
}

/* Goals Grid */
.goal-card {
  padding: 24px;
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.goal-icon-wrapper {
  width: 44px;
  height: 44px;
  border-radius: var(--border-radius-md);
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
}

.goal-icon-wrapper.house { color: var(--color-equity); background: rgba(59, 130, 246, 0.15); }
.goal-icon-wrapper.trip { color: var(--color-warning); background: rgba(245, 158, 11, 0.15); }
.goal-icon-wrapper.car { color: var(--color-crypto); background: rgba(236, 72, 153, 0.15); }
.goal-icon-wrapper.retire { color: var(--color-mf); background: rgba(16, 185, 129, 0.15); }

.goal-title {
  font-size: 1rem;
  font-weight: 700;
}

.goal-target {
  font-size: 0.75rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.goal-progress-box {
  margin: 18px 0;
}

.goal-progress-stats {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  font-size: 0.8rem;
  margin-bottom: 6px;
}

.goal-percentage {
  font-weight: 700;
  color: var(--text-primary);
}

.goal-saved-ratio {
  color: var(--text-secondary);
}

.goal-progress-bar {
  height: 8px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 99px;
  overflow: hidden;
}

.goal-progress-fill {
  height: 100%;
  border-radius: 99px;
  transition: width 0.5s ease;
}

.goal-progress-fill.house { background: var(--color-equity); }
.goal-progress-fill.trip { background: var(--color-warning); }
.goal-progress-fill.car { background: var(--color-crypto); }
.goal-progress-fill.retire { background: var(--color-mf); }

.goal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid var(--border-glass);
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.goal-sip-linked span {
  font-weight: 700;
  color: var(--color-success);
}

/* Learn page explainers */
.explainer-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 180px;
}

.explainer-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.explainer-cat {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.explainer-cat.basics { color: var(--color-equity); }
.explainer-cat.returns { color: var(--color-mf); }
.explainer-cat.tax { color: var(--color-warning); }
.explainer-cat.alloc { color: var(--color-fd); }
.explainer-cat.stocks { color: var(--color-nps); }
.explainer-cat.mf { color: var(--color-crypto); }

.explainer-title {
  font-size: 0.92rem;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text-primary);
  margin-bottom: auto;
}

.explainer-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.75rem;
  color: var(--text-secondary);
  margin-top: 16px;
}

/* Calculators and Interactive elements */
.calculator-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  margin-top: 20px;
}

.calculator-inputs {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-label-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  font-weight: 600;
}

.input-val-box {
  color: var(--color-equity);
}

.input-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 6px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.08);
  outline: none;
}

.input-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-equity);
  cursor: pointer;
  transition: transform 0.1s;
}

.input-slider::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

.numeric-input {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  padding: 10px 14px;
  border-radius: var(--border-radius-md);
  color: white;
  font-family: var(--font-main);
  outline: none;
}

.numeric-input:focus {
  border-color: var(--border-glass-focus);
}

.calculator-outputs {
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--border-radius-lg);
  padding: 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 1px solid var(--border-glass);
}

.output-hero {
  text-align: center;
  margin-bottom: 24px;
}

.output-hero-label {
  font-size: 0.78rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.output-hero-val {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--color-success);
  margin-top: 6px;
  letter-spacing: -1px;
}

.output-row {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  border-top: 1px solid var(--border-glass);
  font-size: 0.88rem;
}

.output-row-val {
  font-weight: 700;
}

/* Quiz Styling */
.quiz-container {
  max-width: 600px;
  margin: 0 auto;
}

.quiz-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.quiz-question-box {
  margin-bottom: 24px;
}

.quiz-question-text {
  font-size: 1.1rem;
  font-weight: 700;
  line-height: 1.4;
}

.quiz-options-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  list-style: none;
}

.quiz-option {
  padding: 14px 18px;
  border-radius: var(--border-radius-md);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.88rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quiz-option:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--border-glass-focus);
}

.quiz-option.correct {
  background: rgba(16, 185, 129, 0.1);
  border-color: var(--color-success);
  color: white;
}

.quiz-option.incorrect {
  background: rgba(239, 68, 68, 0.1);
  border-color: var(--color-danger);
  color: white;
}

.quiz-feedback {
  margin-top: 20px;
  padding: 14px 18px;
  border-radius: var(--border-radius-md);
  font-size: 0.85rem;
  line-height: 1.4;
  display: none;
}

.quiz-feedback.correct {
  background: rgba(16, 185, 129, 0.05);
  border: 1px solid rgba(16, 185, 129, 0.2);
  color: var(--color-success);
  display: block;
}

.quiz-feedback.incorrect {
  background: rgba(239, 68, 68, 0.05);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: var(--color-danger);
  display: block;
}

/* Chatbot Interface */
.chat-layout {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 24px;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  height: calc(100vh - var(--topbar-height) - 100px);
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24px;
  border-bottom: 1px solid var(--border-glass);
}

.chat-header-left {
  display: flex;
  flex-direction: column;
}

.chat-buddy-title {
  font-size: 1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
}

.chat-buddy-subtitle {
  font-size: 0.7rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  color: var(--color-success);
  font-weight: 600;
}

.status-dot {
  width: 6px;
  height: 6px;
  background: var(--color-success);
  border-radius: 99px;
  box-shadow: 0 0 8px var(--color-success);
}

.chat-messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.message-wrapper {
  display: flex;
  gap: 12px;
  max-width: 80%;
}

.message-wrapper.user {
  margin-left: auto;
  flex-direction: row-reverse;
}

.message-avatar {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
  flex-shrink: 0;
  color: white;
}

.message-wrapper.ai .message-avatar {
  background: linear-gradient(135deg, #ec4899, #8b5cf6);
}

.message-wrapper.user .message-avatar {
  background: linear-gradient(135deg, #10b981, #059669);
}

.message-bubble {
  padding: 12px 16px;
  border-radius: var(--border-radius-md);
  font-size: 0.88rem;
  line-height: 1.5;
}

.message-wrapper.ai .message-bubble {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-glass);
  color: var(--text-primary);
  border-top-left-radius: 2px;
}

.message-wrapper.user .message-bubble {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.2);
  color: white;
  border-top-right-radius: 2px;
}

.message-bubble p {
  margin-bottom: 8px;
}

.message-bubble p:last-child {
  margin-bottom: 0;
}

.message-bubble ul {
  padding-left: 20px;
  margin-bottom: 8px;
}

.message-bubble li {
  margin-bottom: 4px;
}

.message-bubble code {
  font-family: monospace;
  background: rgba(0,0,0,0.3);
  padding: 2px 4px;
  border-radius: 4px;
}

.typing-indicator {
  display: flex;
  gap: 4px;
  align-items: center;
  padding: 6px 12px;
}

.typing-dot {
  width: 6px;
  height: 6px;
  background: var(--text-muted);
  border-radius: 50%;
  animation: typingBounce 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

.suggested-chips {
  display: flex;
  gap: 8px;
  padding: 8px 24px;
  overflow-x: auto;
}

.suggested-chip {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  border-radius: 99px;
  padding: 6px 14px;
  font-family: var(--font-main);
  font-size: 0.78rem;
  color: var(--text-secondary);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}

.suggested-chip:hover {
  background: var(--bg-glass-card);
  color: var(--text-primary);
  border-color: var(--border-glass-focus);
}

.chat-input-area {
  padding: 16px 24px;
  border-top: 1px solid var(--border-glass);
  display: flex;
  gap: 12px;
  align-items: center;
}

.chat-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-glass);
  border-radius: var(--border-radius-lg);
  padding: 12px 18px;
  color: white;
  font-family: var(--font-main);
  font-size: 0.88rem;
  outline: none;
  transition: border-color 0.2s;
}

.chat-input:focus {
  border-color: var(--border-glass-focus);
}

.disclaimer-box {
  padding: 10px 16px;
  background: rgba(255, 255, 255, 0.01);
  border-top: 1px solid var(--border-glass);
  font-size: 0.7rem;
  color: var(--text-muted);
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.disclaimer-box i {
  margin-top: 2px;
  font-size: 0.8rem;
}

/* Portfolio Health Panel (Right Sidebar in Chat) */
.health-panel {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.health-score-hero {
  text-align: center;
  padding: 24px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--border-radius-lg);
  border: 1px solid var(--border-glass);
}

.health-score-val {
  font-size: 3rem;
  font-weight: 800;
  background: linear-gradient(to right, var(--color-success), var(--color-equity));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 4px;
}

.health-score-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-success);
  text-transform: uppercase;
}

.health-subscores {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 8px;
}

.health-subscore-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.health-subscore-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.health-subscore-bar-bg {
  height: 6px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 99px;
  overflow: hidden;
}

.health-subscore-bar-fill {
  height: 100%;
  background: var(--color-equity);
  border-radius: 99px;
}

/* Notifications Page List */
.notif-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.notif-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.notif-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px 20px;
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.015);
  border: 1px solid var(--border-glass);
  transition: all 0.2s;
}

.notif-row:hover {
  background: rgba(255, 255, 255, 0.03);
}

.notif-row.unread {
  background: rgba(59, 130, 246, 0.04);
  border-color: rgba(59, 130, 246, 0.15);
}

.notif-icon-box {
  width: 40px;
  height: 40px;
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.notif-icon-box.warning { background: rgba(245, 158, 11, 0.15); color: var(--color-warning); }
.notif-icon-box.success { background: rgba(16, 185, 129, 0.15); color: var(--color-success); }
.notif-icon-box.info { background: rgba(59, 130, 246, 0.15); color: var(--color-info); }

.notif-body {
  flex: 1;
}

.notif-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.notif-title {
  font-size: 0.9rem;
  font-weight: 700;
}

.notif-desc {
  font-size: 0.82rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

.notif-time {
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 6px;
}

/* Profile page settings */
.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 20px;
}

.profile-avatar-lg {
  width: 70px;
  height: 70px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--color-fd), var(--color-crypto));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 1.8rem;
  color: white;
  box-shadow: var(--shadow-glow);
}

.profile-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.profile-name {
  font-size: 1.2rem;
  font-weight: 800;
}

.profile-mobile {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.risk-level-badge {
  font-size: 1.1rem;
  font-weight: 800;
  background: linear-gradient(to right, #ffffff, #9ca3af);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 6px;
}

.risk-level-badge.conservative { color: var(--color-success); }
.risk-level-badge.moderate { color: var(--color-warning); }
.risk-level-badge.aggressive { color: var(--color-danger); }

.risk-desc {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 16px;
}

.linked-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-radius: var(--border-radius-md);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  margin-bottom: 10px;
}

.linked-account-logo {
  width: 32px;
  height: 32px;
  border-radius: var(--border-radius-sm);
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.72rem;
}

.linked-account-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.linked-account-name {
  font-size: 0.85rem;
  font-weight: 600;
}

.linked-account-source {
  font-size: 0.72rem;
  color: var(--text-secondary);
}

/* Toggle Switch Styling */
.toggle-settings-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.toggle-setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toggle-setting-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-width: 80%;
}

.toggle-setting-name {
  font-size: 0.88rem;
  font-weight: 600;
}

.toggle-setting-desc {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

/* Visual toggle switch */
.switch {
  position: relative;
  display: inline-block;
  width: 44px;
  height: 22px;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255,255,255,0.08);
  border: 1px solid var(--border-glass);
  transition: .3s;
  border-radius: 34px;
}

.slider:before {
  position: absolute;
  content: "";
  height: 14px;
  width: 14px;
  left: 3px;
  bottom: 3px;
  background-color: var(--text-secondary);
  transition: .3s;
  border-radius: 50%;
}

input:checked + .slider {
  background-color: var(--color-equity);
  border-color: var(--color-equity);
}

input:checked + .slider:before {
  transform: translateX(22px);
  background-color: white;
}

/* Modals styling */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  z-index: 200;
  display: none;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

.modal-overlay.active {
  display: flex;
}

.modal-content {
  background: var(--bg-secondary);
  border: 1px solid var(--border-glass);
  border-radius: var(--border-radius-lg);
  padding: 32px;
  width: 100%;
  max-width: 500px;
  box-shadow: var(--shadow-glow);
  position: relative;
  animation: slideUp 0.3s cubic-bezier(0.19, 1, 0.22, 1);
}

@keyframes slideUp {
  from { transform: translateY(30px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 1.25rem;
  transition: color 0.2s;
}

.modal-close-btn:hover {
  color: var(--text-primary);
}

.modal-title {
  font-size: 1.2rem;
  font-weight: 800;
  margin-bottom: 16px;
  letter-spacing: -0.5px;
}

.modal-form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}

.modal-form-group label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.modal-form-group input, .modal-form-group select {
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-glass);
  border-radius: var(--border-radius-md);
  padding: 12px;
  color: white;
  font-family: var(--font-main);
  font-size: 0.88rem;
  outline: none;
}

.modal-form-group input:focus, .modal-form-group select:focus {
  border-color: var(--border-glass-focus);
}

.modal-footer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
}

/* Learn hub tab sections styling */
.learn-tabs {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
}

.learn-tab {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  color: var(--text-secondary);
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 600;
  padding: 10px 20px;
  border-radius: var(--border-radius-lg);
  cursor: pointer;
  transition: all 0.2s;
}

.learn-tab:hover {
  background: var(--bg-glass-card);
  color: var(--text-primary);
}

.learn-tab.active {
  background: var(--color-equity);
  color: white;
  border-color: var(--color-equity);
}

.learn-section {
  display: none;
}

.learn-section.active {
  display: block;
}

/* Table styling in Portfolio */
.portfolio-table {
  width: 100%;
  border-collapse: collapse;
}

.portfolio-table th {
  text-align: left;
  font-size: 0.72rem;
  text-transform: uppercase;
  color: var(--text-secondary);
  letter-spacing: 0.5px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-glass);
}

.portfolio-table td {
  padding: 16px;
  border-bottom: 1px solid var(--border-glass);
  font-size: 0.85rem;
}

.portfolio-table tbody tr:hover {
  background: rgba(255, 255, 255, 0.015);
}

.portfolio-asset-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.portfolio-asset-logo {
  width: 32px;
  height: 32px;
  border-radius: var(--border-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.75rem;
}

.portfolio-asset-logo.eq { background: rgba(59, 130, 246, 0.2); color: var(--color-equity); }
.portfolio-asset-logo.mf { background: rgba(16, 185, 129, 0.2); color: var(--color-mf); }
.portfolio-asset-logo.gold { background: rgba(245, 158, 11, 0.2); color: var(--color-gold); }
.portfolio-asset-logo.fd { background: rgba(139, 92, 246, 0.2); color: var(--color-fd); }
.portfolio-asset-logo.nps { background: rgba(6, 182, 212, 0.2); color: var(--color-nps); }
.portfolio-asset-logo.crypto { background: rgba(236, 72, 153, 0.2); color: var(--color-crypto); }

/* Responsive Adjustments */
@media (max-width: 1024px) {
  .dashboard-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .col-span-2, .col-span-3, .col-span-4 {
    grid-column: span 2;
  }
  .calculator-grid {
    grid-template-columns: 1fr;
  }
  .chat-layout {
    grid-template-columns: 1fr;
  }
  .profile-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .sidebar {
    width: 70px;
    padding: 24px 8px;
    align-items: center;
  }
  .brand-info, .brand-section span, .nav-item span, .user-info, .settings-dots {
    display: none;
  }
  .logo-container {
    width: 36px;
    height: 36px;
  }
  .main-wrapper {
    margin-left: 70px;
  }
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
  .col-span-2, .col-span-3, .col-span-4 {
    grid-column: span 1;
  }
  .topbar {
    padding: 0 16px;
  }
  .search-container {
    width: 180px;
  }
  .content-area {
    padding: 16px;
  }
}
